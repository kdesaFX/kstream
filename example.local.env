# Localhost / PWA mode (no Cloudflare)
#
# Build + serve the production Worker stack on 127.0.0.1:
#   pnpm serve:local
# Then open http://127.0.0.1:8787 and optionally "Install app" from the browser.
#
# Copy values you need into .env before building, or rely on public/config.js
# runtime overrides after the build.

VITE_TMDB_READ_API_KEY=...
VITE_OPENSEARCH_ENABLED=false

VITE_CORS_PROXY_URL=/api/proxy
VITE_M3U8_PROXY_URL=/api

VITE_APP_DOMAIN=http://127.0.0.1:8787
VITE_NORMAL_ROUTER=true
VITE_HAS_ONBOARDING=true

# Optional: installable PWA from localhost
# VITE_PWA_ENABLED=true

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
