VITE_TMDB_READ_API_KEY=...
VITE_OPENSEARCH_ENABLED=false

# Same-origin Vercel proxies (see /api). Must NOT end with a slash.
# Relative paths are fine — resolved to the current origin at runtime.
VITE_CORS_PROXY_URL=/api/proxy

# Base for /m3u8-proxy and /ts-proxy. Must NOT end with a slash.
VITE_M3U8_PROXY_URL=/api

# make sure the domain does NOT have a slash at the end
VITE_APP_DOMAIN=http://localhost:5173

# Supabase (accounts sync + auth). Anon key only — never commit service role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend URL(s) - optional legacy movie-web backend for non-account features
VITE_BACKEND_URL=https://server1.com,https://server2.com,https://server3.com

# Trakt integration setup. Get these at https://trakt.tv/oauth/applications
VITE_TRAKT_CLIENT_ID=
VITE_TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=https://your domain
